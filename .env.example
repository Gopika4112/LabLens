# Server-side only. Never prefix these with VITE_ (that would ship them to the browser).
# LabLens works fully offline without any of these; they only enable photo parsing and AI chat.
# Pick ONE provider. Free options first.

# 1) Google Gemini free tier (default). Free key: https://aistudio.google.com/apikey
#    Default model gemini-3.5-flash-lite (free, accepts images). Note: free-tier prompts may be used by Google to improve its products.
GEMINI_API_KEY=

# 2) Ollama: 100% free, runs on your own machine or a school server, works with no internet.
#    Install from https://ollama.com, then: ollama pull qwen2.5vl:7b
# OLLAMA_BASE_URL=http://localhost:11434

# 3) OpenRouter free models (set LLM_MODEL to a model id ending in ":free" that accepts images).
# OPENROUTER_API_KEY=
# LLM_MODEL=

# 4) Groq free tier (fast; default model is text-only, so photos need a vision LLM_MODEL).
# GROQ_API_KEY=

# 5) Any OpenAI-compatible server
# LLM_BASE_URL=
# LLM_API_KEY=

# 6) Claude (paid)
# ANTHROPIC_API_KEY=

# Optional overrides
# LLM_PROVIDER=gemini   # gemini | ollama | openrouter | groq | custom | claude
# LLM_MODEL=gemini-3.8-flash
